daylex.it {
    encode zstd gzip
    header {
        -Server
        X-Robots-Tag "noindex, nofollow, nosnippet, noimageindex"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    redir /app /app/ 308
    handle /v1/* {
        reverse_proxy 127.0.0.1:8787 {
            flush_interval -1
        }
    }
    handle_path /app/* {
        root * /srv/daylex-pwa/current
        header {
            Cache-Control no-cache
            Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; base-uri 'self'; frame-ancestors 'none'"
        }
        file_server
    }
    handle {
        root * /srv/daylex-site/current
        header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        @installer path /downloads/*.exe /downloads/*.dmg /downloads/*.zip /downloads/*.sha256
        header @installer {
            Content-Disposition attachment
            Cache-Control "public, max-age=31536000, immutable"
        }
        @page not path /downloads/*
        header @page Cache-Control no-cache
        file_server
    }
    handle_errors {
        header X-Robots-Tag "noindex, nofollow, nosnippet, noimageindex"
        @down expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
        handle @down {
            header Content-Type "application/json; charset=utf-8"
            respond `{"detail":"Il servizio non è attivo in questo momento: riprova più tardi."}` 503
        }
    }
}
www.daylex.it {
    header X-Robots-Tag "noindex, nofollow, nosnippet, noimageindex"
    redir https://daylex.it{uri} permanent
}
